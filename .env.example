# ═══════════════════════════════════════════════════════════
# SESSION-BASED AUTHENTICATION (Username/Password)
# ═══════════════════════════════════════════════════════════

# Instagram
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password
INSTAGRAM_2FA_SECRET=your_2fa_secret_optional

# TikTok
TIKTOK_USERNAME=your_username
TIKTOK_PASSWORD=your_password

# Twitter/X
TWITTER_USERNAME=your_username
TWITTER_PASSWORD=your_password
TWITTER_EMAIL=your_email_for_verification

# Facebook
FACEBOOK_USERNAME=your_username
FACEBOOK_PASSWORD=your_password

# LinkedIn
LINKEDIN_USERNAME=your_username
LINKEDIN_PASSWORD=your_password

# ═══════════════════════════════════════════════════════════
# OFFICIAL API KEYS (Alternative to session-based)
# ═══════════════════════════════════════════════════════════

TWITTER_API_KEY=your_key
TWITTER_API_SECRET=your_secret
TWITTER_ACCESS_TOKEN=your_token
TWITTER_ACCESS_SECRET=your_token_secret

LINKEDIN_ACCESS_TOKEN=your_token
LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXX

FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_ACCESS_TOKEN=your_token

YOUTUBE_CLIENT_ID=your_id
YOUTUBE_CLIENT_SECRET=your_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token

# ═══════════════════════════════════════════════════════════
# AI CONFIGURATION
# ═══════════════════════════════════════════════════════════

ANTHROPIC_API_KEY=your_anthropic_key

# ═══════════════════════════════════════════════════════════
# SESSION CONFIGURATION
# ═══════════════════════════════════════════════════════════

SESSION_STORAGE_PATH=~/.social_agent/sessions
SESSION_ENCRYPTION_KEY=change_this_to_32_random_chars!!
SESSION_MAX_AGE_DAYS=7
SESSION_HEADLESS=true

# ═══════════════════════════════════════════════════════════
# CIRCUIT BREAKER & RETRY
# ═══════════════════════════════════════════════════════════

CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT=300
MAX_RETRIES=3
RETRY_DELAY_BASE=2

# ═══════════════════════════════════════════════════════════
# POSTIZ INTEGRATION (Optional)
# ═══════════════════════════════════════════════════════════

POSTIZ_URL=http://localhost:5000
POSTIZ_API_TOKEN=your_token

# ═══════════════════════════════════════════════════════════
# GENERAL
# ═══════════════════════════════════════════════════════════

SITE_URL=https://yoursite.com
